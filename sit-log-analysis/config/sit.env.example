# Copy to config/sit.env and customize. Do not commit sit.env.

# SSH / SCP target (jump host or direct SIT bastion)
SIT_USER=your_sit_user
SIT_JUMP=sit-jump.example.com
SIT_PORT=22

# Remote path after ops collector runs (see scripts/trigger-remote-export.sh)
REMOTE_EXPORT=/tmp/export/latest.tar.gz

# Optional: remote collector script (approved by platform team)
REMOTE_COLLECTOR_SCRIPT=/opt/log-export/collect-api-logs.sh
REMOTE_COLLECTOR_USER=logcollector

# Local work root (Git Bash paths: use /c/... or C:/...)
LOCAL_ROOT=/c/LogAnalysis/sit

# Default service label for subfolder layout
DEFAULT_SERVICE=payments-api

# Python executable (python3 or python); used instead of jq for queries
# PYTHON_CMD=python3
