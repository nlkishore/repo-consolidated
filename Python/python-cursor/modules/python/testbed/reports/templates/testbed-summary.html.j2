<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Testbed Summary — {{ summary.get('run_at', '') }}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #222; }
    h1, h2 { color: #333; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ccc; padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
    th { background: #f0f0f0; }
    .PASS { color: #1a7a1a; font-weight: bold; }
    .FAIL { color: #c00; font-weight: bold; }
    .WARN { color: #b86b00; font-weight: bold; }
    .badge-pass { background: #d4edda; color: #155724; padding: 2px 8px; border-radius: 4px; }
    .badge-fail { background: #f8d7da; color: #721c24; padding: 2px 8px; border-radius: 4px; }
    pre { background: #f8f8f8; padding: 1rem; border-radius: 4px; overflow-x: auto; }
    ul { margin: 0.5rem 0; padding-left: 1.5rem; }
  </style>
</head>
<body>
  <h1>Testbed Seed Summary</h1>
  <p>
    <strong>Status:</strong>
    {% if validation.ok %}
      <span class="badge-pass">PASS</span>
    {% else %}
      <span class="badge-fail">FAIL</span>
    {% endif %}
    &nbsp;&nbsp;
    <strong>Run at:</strong> {{ summary.get('run_at', 'unknown') }}
  </p>

  <h2>Scenarios seeded</h2>
  <table>
    <thead>
      <tr>
        <th>Scenario</th>
        <th>Companies</th>
        <th>Entities</th>
        <th>Users</th>
        <th>Roles</th>
        <th>Permissions</th>
        <th>Groups</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for s in summary.get('scenarios', []) %}
      <tr>
        <td><strong>{{ s.name }}</strong></td>
        <td>{{ s.get('companies', 0) }}</td>
        <td>{{ s.get('entities', 0) }}</td>
        <td>{{ s.get('users', 0) }}</td>
        <td>{{ s.get('roles', 0) }}</td>
        <td>{{ s.get('permissions', 0) }}</td>
        <td>{{ s.get('groups', 0) }}</td>
        <td class="{{ s.get('status', 'PASS') }}">{{ s.get('status', 'PASS') }}</td>
      </tr>
      {% else %}
      <tr><td colspan="8">No scenarios recorded.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Validation checks</h2>
  <table>
    <thead>
      <tr><th>Check</th><th>Value</th><th>Status</th></tr>
    </thead>
    <tbody>
      {% for c in validation.checks %}
      <tr>
        <td>{{ c.check }}</td>
        <td>{{ c.value }}</td>
        <td class="{{ c.status }}">{{ c.status }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if validation.errors %}
  <h2>Errors</h2>
  <ul>
    {% for e in validation.errors %}
    <li class="FAIL">{{ e }}</li>
    {% endfor %}
  </ul>
  {% endif %}

  <h2>Seeded personas</h2>
  <table>
    <thead>
      <tr><th>Login ID</th><th>Scenario</th><th>Role(s)</th><th>Company</th></tr>
    </thead>
    <tbody>
      {% for p in summary.get('personas', []) %}
      <tr>
        <td><code>{{ p.login_id }}</code></td>
        <td>{{ p.scenario }}</td>
        <td>{{ p.roles | join(', ') }}</td>
        <td>{{ p.company }}</td>
      </tr>
      {% else %}
      <tr><td colspan="4">No persona data.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
